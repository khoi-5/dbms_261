SERVER_PORT=8080
# Optional: CATALOG_DEFAULT_PAGE_SIZE=12, CATALOG_MAX_PAGE_SIZE=48.


# Loaded as Java .properties: no export, no surrounding quotes.
# Run Maven from backend/. OS environment variables override this file.
# Existing website database; do not run schema/seed scripts to check connectivity.
# Do not substitute an Indexing benchmark database automatically.
DB_NAME=BKPEE_DB

# OPTION 1 (default): Windows Authentication, using the account running Java.
# localhost TCP 1433 was verified by a read-only SQL query.
# Requires mssql-jdbc_auth-<driver-version>.x64.dll matching the JDBC driver
# and x64 JVM. Add its directory to PATH BEFORE starting Java, or use the JVM
# option -Djava.library.path=<directory>. Do not commit the DLL.
DB_URL=jdbc:sqlserver://localhost:1433;databaseName=${DB_NAME};integratedSecurity=true;authenticationScheme=NativeAuthentication;encrypt=true;trustServerCertificate=true;loginTimeout=5
DB_USERNAME=
DB_PASSWORD=

# OPTION 2: SQL Server Authentication with a dedicated least-privilege login.
# Comment OPTION 1 DB_URL; uncomment the URL below, and fill the two credential
# variables above in your ignored .env. Server must support SQL Authentication.
# integratedSecurity must be false; the native auth DLL is not required.
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=${DB_NAME};integratedSecurity=false;encrypt=true;trustServerCertificate=true;loginTimeout=5
# Never commit real passwords. trustServerCertificate=true is for local demo;
# production must validate a trusted certificate (trustServerCertificate=false).

# Required: Base64 encoding of at least 32 cryptographically random bytes.
# Intentionally invalid placeholder: replace ONLY in the ignored .env.
# Generate in PowerShell (works in Windows PowerShell 5.1 and PowerShell 7):
# $key = New-Object byte[] 32
# $rng = [Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($key); [Convert]::ToBase64String($key); $rng.Dispose()
JWT_SECRET=REPLACE_WITH_RANDOM_BASE64_SECRET
JWT_EXPIRATION_MINUTES=120
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
